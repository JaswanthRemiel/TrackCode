rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. SHARED LIBRARY
    match /problems/{problemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 2. USER PROFILES
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. PRIVATE TRACKING DATA
    match /{collection}/{id} {
      allow read, write: if collection in ['userProgress', 'notes', 'dailyActivity'] &&
                           request.auth != null &&
                           // READS: Simply check that the data belongs to the user
                           ((resource != null && resource.data.userId == request.auth.uid) ||
                           // WRITES: Enforce both UID in data AND standard ID format
                           (request.resource != null &&
                            request.resource.data.userId == request.auth.uid &&
                            id.matches('^' + request.auth.uid + '.*')));
    }

    // 4. REMIEL CHATS (auto-generated ids, owner stored in userId)
    match /remielChats/{chatId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data) &&
                       request.resource.data.messages is list &&
                       request.resource.data.messages.size() <= 200;
      allow update: if isOwner(resource.data) &&
                       isOwner(request.resource.data) &&
                       request.resource.data.messages is list &&
                       request.resource.data.messages.size() <= 200;
    }

    // 5. REMIEL STUDY PLANS
    match /remielPlans/{planId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data) &&
                       request.resource.data.days is list &&
                       request.resource.data.days.size() <= 60;
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
    }

    function isOwner(data) {
      return request.auth != null && data.userId == request.auth.uid;
    }
  }
}
